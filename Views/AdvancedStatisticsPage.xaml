<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WeatherApp.Views.AdvancedStatisticsPage"
    Title="Mai mult statistici">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="18">

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">

                <Button
                    Text="‹"
                    FontSize="28"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="14"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                    TextColor="{AppThemeBinding Light=#263238, Dark=White}"
                    Clicked="Back_Clicked"/>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center">
                    <Label
                        Text="Analiză meteo"
                        FontSize="25"
                        FontAttributes="Bold"/>

                    <Label
                        x:Name="CityTitle"
                        Text="Oraș selectat"
                        StyleClass="Muted"
                        FontSize="13"/>
                </VerticalStackLayout>
            </Grid>

            <Border
                BackgroundColor="{AppThemeBinding Light=#E8F0FE, Dark=#1E2D3A}"
                StrokeThickness="0"
                Padding="14"
                StrokeShape="RoundRectangle 14">

                <Label
                    x:Name="PeriodTitle"
                    Text="Analiza perioadei selectate"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light=#2456A6, Dark=#8FB8F0}"/>
            </Border>

            <Border StyleClass="Card"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">
                    <Label Text="💨  Viteza vantului"
                           FontSize="19"
                           FontAttributes="Bold"/>

                    <Label Text="Evolutia zilnica a vitezei vantului (km/h)"
                           StyleClass="Muted"
                           FontSize="12"/>

                    <GraphicsView
                        x:Name="WindChart"
                        HeightRequest="220"/>

                    <Label Text="Graficul arata cum a variat viteza medie a vantului in fiecare zi."
                           StyleClass="Muted"
                           FontSize="12"/>
                </VerticalStackLayout>
            </Border>


            <Border StyleClass="Card"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="16">
                    <Label Text="📊  Comparatie între perioade"
                           FontSize="19"
                           FontAttributes="Bold"/>

                    <Label Text="Perioada selectată comparata cu intervalul anterior."
                           StyleClass="Muted"
                           FontSize="12"/>


                    <VerticalStackLayout Spacing="4">
                        <Label Text="Temperatura medie (°C)"
                               FontAttributes="Bold"
                               FontSize="14"/>

                        <GraphicsView
                            x:Name="ComparisonTemperatureChart"
                            HeightRequest="125"/>

                        <Label x:Name="TemperatureComparisonLabel"
                               Text="—"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#E87532"/>

                        <Label x:Name="TemperatureExplanation"
                               Text="Comparatia temperaturilor va fi afisata aici."
                               StyleClass="Muted"
                               FontSize="12"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#EDF0F4, Dark=#3A3A3A}"/>


                    <VerticalStackLayout Spacing="4">
                        <Label Text="Umiditate medie (%)"
                               FontAttributes="Bold"
                               FontSize="14"/>

                        <GraphicsView
                            x:Name="ComparisonHumidityChart"
                            HeightRequest="125"/>

                        <Label x:Name="HumidityComparisonLabel"
                               Text="—"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#2196A6"/>

                        <Label x:Name="HumidityExplanation"
                               Text="Comparatia umiditatii va fi afisata aici."
                               StyleClass="Muted"
                               FontSize="12"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#EDF0F4, Dark=#3A3A3A}"/>


                    <VerticalStackLayout Spacing="4">
                        <Label Text="Viteza medie vant (km/h)"
                               FontAttributes="Bold"
                               FontSize="14"/>

                        <GraphicsView
                            x:Name="ComparisonWindChart"
                            HeightRequest="125"/>

                        <Label x:Name="WindComparisonLabel"
                               Text="—"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#00897B"/>

                        <Label x:Name="WindExplanation"
                               Text="Comparatia vantului va fi afisata aici."
                               StyleClass="Muted"
                               FontSize="12"/>
                    </VerticalStackLayout>

                    <Label x:Name="ComparisonDescription"
                           Text="Valorile compara mediile celor doua perioade."
                           StyleClass="Muted"
                           FontSize="11"/>
                </VerticalStackLayout>
            </Border>


            <Border StyleClass="Card"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="14">
                    <Label Text="🏆  Recorduri meteo"
                           FontSize="19"
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#FFF1E7, Dark=#3A2A1E}"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Temperatura maxima"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#A65B25, Dark=#FFB77A}"/>
                                <Label x:Name="MaxTemperatureLabel"
                                       Text="—"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#E65100, Dark=#FF8A50}"/>
                                <Label x:Name="MaxTemperatureDateLabel"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#946B50, Dark=#C9A68E}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#EAF3FF, Dark=#1E2D3A}"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Temperatura minima"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#35649B, Dark=#8FB8F0}"/>
                                <Label x:Name="MinTemperatureLabel"
                                       Text="—"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}"/>
                                <Label x:Name="MinTemperatureDateLabel"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#617D9C, Dark=#9DB5CF}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#E5F7F7, Dark=#1E3A3A}"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Umiditate maxima"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#287C83, Dark=#7FD0D6}"/>
                                <Label x:Name="MaxHumidityLabel"
                                       Text="—"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#00838F, Dark=#4DD0E1}"/>
                                <Label x:Name="MaxHumidityDateLabel"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#527F83, Dark=#92BFC3}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#F2EAFE, Dark=#2D2540}"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Vant maxim"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#76549B, Dark=#C3A5E8}"/>
                                <Label x:Name="MaxWindLabel"
                                       Text="—"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6A1B9A, Dark=#CE93D8}"/>
                                <Label x:Name="MaxWindDateLabel"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#806D98, Dark=#BBA8D0}"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>


            <Border StyleClass="Card"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">
                    <Label Text="🗓️  Calendar termic"
                           FontSize="19"
                           FontAttributes="Bold"/>

                    <Label Text="Temperatura medie in fiecare zi"
                           StyleClass="Muted"
                           FontSize="12"/>

                    <ScrollView
                    HeightRequest="320"
                    Orientation="Vertical">

                        <GraphicsView
                        x:Name="WeatherCalendar"
                        HeightRequest="300"
                        VerticalOptions="Start"/>
                    </ScrollView>

                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto"
                          ColumnSpacing="4">
                        <BoxView Grid.Column="0"
                                 Color="#1565C0"
                                 WidthRequest="8"
                                 HeightRequest="8"/>
                        <Label Grid.Column="1"
                               Text="Rece"
                               StyleClass="Muted"
                               FontSize="10"/>

                        <BoxView Grid.Column="2"
                                 Color="#42A5F5"
                                 WidthRequest="8"
                                 HeightRequest="8"/>
                        <Label Grid.Column="3"
                               Text="Moderat"
                               StyleClass="Muted"
                               FontSize="10"/>

                        <BoxView Grid.Column="4"
                                 Color="#FDD835"
                                 WidthRequest="8"
                                 HeightRequest="8"/>
                        <Label Grid.Column="5"
                               Text="Cald"
                               StyleClass="Muted"
                               FontSize="10"/>

                        <BoxView Grid.Column="6"
                                 Color="#E53935"
                                 WidthRequest="8"
                                 HeightRequest="8"/>
                    </Grid>

                    <Label Text="Fiecare celula reprezinta o zi. Culoarea indica nivelul temperaturii medii."
                           StyleClass="Muted"
                           FontSize="12"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>