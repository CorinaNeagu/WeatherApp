<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherApp.Controls"
    x:Class="WeatherApp.Views.AirQualityPage"
    Title="Calitatea aerului">

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">

            <Label
                Text="Calitatea aerului"
                FontSize="28"
                FontAttributes="Bold"/>

            <Label
                Text="Verifică nivelul poluării în orașul ales."
                StyleClass="Muted"
                FontSize="14"/>

            <controls:CitySearchBox
                x:Name="CityBox"
                Placeholder="Introdu orașul"
                SearchCompleted="OnCheckClicked"/>

            <Button
                Text="Verifică aerul"
                Clicked="OnCheckClicked"
                FontSize="16"
                HeightRequest="50"/>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False"/>

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                TextColor="#DC2626"/>

            <Border
                StyleClass="Card"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="8">

                    <Label
                        x:Name="CityLabel"
                        Text="Orașul selectat"
                        StyleClass="Muted"
                        FontSize="16"/>

                    <Label
                        Text="Indice european AQI"
                        FontSize="18"
                        FontAttributes="Bold"/>

                    <Label
                        x:Name="AqiLabel"
                        Text="--"
                        FontSize="48"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

                    <Label
                        Text="Cu cât valoarea este mai mică, cu atât aerul este mai curat."
                        StyleClass="Muted"
                        FontSize="13"/>

                    <Label
                        x:Name="AqiStatusLabel"
                        Text="Caută un oraș pentru a vedea nivelul."
                        StyleClass="Body"
                        FontSize="16"
                        FontAttributes="Bold"/>

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Poluanți măsurați"
                FontSize="21"
                FontAttributes="Bold"/>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Border
                    StyleClass="Card"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="PM2.5"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#2563EB"/>
                        <Label
                            x:Name="Pm25Label"
                            Text="-- µg/m³"
                            FontSize="17"/>
                        <Label
                            Text="Particule fine"
                            StyleClass="Muted"
                            FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    StyleClass="Card"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="PM10"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#D97706"/>
                        <Label
                            x:Name="Pm10Label"
                            Text="-- µg/m³"
                            FontSize="17"/>
                        <Label
                            Text="Particule în suspensie"
                            StyleClass="Muted"
                            FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Row="1"
                    StyleClass="Card"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="NO₂"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#7C3AED"/>
                        <Label
                            x:Name="No2Label"
                            Text="-- µg/m³"
                            FontSize="17"/>
                        <Label
                            Text="Dioxid de azot"
                            StyleClass="Muted"
                            FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    StyleClass="Card"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="O₃"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#059669"/>
                        <Label
                            x:Name="OzoneLabel"
                            Text="-- µg/m³"
                            FontSize="17"/>
                        <Label
                            Text="Ozon"
                            StyleClass="Muted"
                            FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Label
                Text="Datele sunt furnizate de Open-Meteo. Valorile reflectă estimările disponibile pentru locația selectată."
                StyleClass="Muted"
                FontSize="12"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>