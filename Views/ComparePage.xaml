<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherApp.Controls"
    x:Class="WeatherApp.Views.ComparePage"
    Title="Compară orașe">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">

            <Label Text="Compară orașe"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="Alege două orașe și vezi diferențele dintre ele."
                   StyleClass="Muted"
                   FontSize="15" />

            <VerticalStackLayout Spacing="10">

                <controls:CitySearchBox x:Name="City1Box"
                                        Placeholder="Primul oraș..." />

                <controls:CitySearchBox x:Name="City2Box"
                                        Placeholder="Al doilea oraș..."
                                        SearchCompleted="OnCompareClicked" />

                <Button Text="Compară"
                        Clicked="OnCompareClicked"
                        FontSize="16"
                        Padding="18,12" />

            </VerticalStackLayout>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="#DC2626" />

            <Border x:Name="SummaryCard"
                    StyleClass="CardAccent"
                    IsVisible="False">
                <Label x:Name="SummaryLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </Border>

            <Grid x:Name="ResultsGrid"
                  IsVisible="False"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <Border StyleClass="Card"
                        Padding="14"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="City1Label" FontSize="17" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="Temp1Label" FontSize="32" FontAttributes="Bold"
                               TextColor="#512BD2" HorizontalOptions="Center" />
                        <Label x:Name="Condition1Label" StyleClass="Muted" FontSize="14"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label x:Name="Feels1Label" />
                        <Label x:Name="Humidity1Label" />
                        <Label x:Name="Wind1Label" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        StyleClass="Card"
                        Padding="14"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="City2Label" FontSize="17" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="Temp2Label" FontSize="32" FontAttributes="Bold"
                               TextColor="#512BD2" HorizontalOptions="Center" />
                        <Label x:Name="Condition2Label" StyleClass="Muted" FontSize="14"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label x:Name="Feels2Label" />
                        <Label x:Name="Humidity2Label" />
                        <Label x:Name="Wind2Label" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>