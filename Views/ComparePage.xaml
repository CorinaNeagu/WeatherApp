<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WeatherApp.Views.ComparePage"
    Title="Compară orașe"
    BackgroundColor="#F3F6FC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">

            <Label
                Text="Compară orașe"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#172554" />

            <Label
                Text="Alege două orașe și vezi diferențele dintre ele."
                FontSize="15"
                TextColor="#64748B" />

            <Border
                BackgroundColor="White"
                Stroke="#DCE3EF"
                StrokeThickness="1"
                Padding="12"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="10">
                    <Entry
                        x:Name="City1Entry"
                        Placeholder="Primul oraș..."
                        TextColor="#172554"
                        PlaceholderColor="#94A3B8"
                        BackgroundColor="White" />

                    <Entry
                        x:Name="City2Entry"
                        Placeholder="Al doilea oraș..."
                        TextColor="#172554"
                        PlaceholderColor="#94A3B8"
                        BackgroundColor="White"
                        ReturnType="Search"
                        Completed="OnCompareClicked" />

                    <Button
                        Text="Compară"
                        Clicked="OnCompareClicked"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="12"
                        Padding="18,12" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="#2563EB" />

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                TextColor="#DC2626" />

            <!-- Rezumatul comparatiei -->
            <Border
                x:Name="SummaryCard"
                IsVisible="False"
                BackgroundColor="#DBEAFE"
                Stroke="#BFDBFE"
                StrokeThickness="1"
                Padding="16"
                StrokeShape="RoundRectangle 16">
                <Label
                    x:Name="SummaryLabel"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#172554"
                    HorizontalTextAlignment="Center" />
            </Border>

            <!-- Cele doua carduri, unul langa altul -->
            <Grid
                x:Name="ResultsGrid"
                IsVisible="False"
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="14"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="City1Label" FontSize="17" FontAttributes="Bold"
                               TextColor="#172554" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="Temp1Label" FontSize="32" FontAttributes="Bold"
                               TextColor="#2563EB" HorizontalOptions="Center" />
                        <Label x:Name="Condition1Label" FontSize="14" TextColor="#475569"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label x:Name="Feels1Label" TextColor="#172554" />
                        <Label x:Name="Humidity1Label" TextColor="#172554" />
                        <Label x:Name="Wind1Label" TextColor="#172554" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="14"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="City2Label" FontSize="17" FontAttributes="Bold"
                               TextColor="#172554" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="Temp2Label" FontSize="32" FontAttributes="Bold"
                               TextColor="#2563EB" HorizontalOptions="Center" />
                        <Label x:Name="Condition2Label" FontSize="14" TextColor="#475569"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label x:Name="Feels2Label" TextColor="#172554" />
                        <Label x:Name="Humidity2Label" TextColor="#172554" />
                        <Label x:Name="Wind2Label" TextColor="#172554" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>