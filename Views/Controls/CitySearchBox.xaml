<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.Controls.CitySearchBox">

    <Border StyleClass="Card">
        <VerticalStackLayout Spacing="0">

            <Grid ColumnDefinitions="Auto,*" Padding="14,4" ColumnSpacing="10">
                <Label Text="⌕" FontSize="24" VerticalOptions="Center"
                       TextColor="#2196F3" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       FontSize="16"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="SearchEntry_TextChanged"
                       Completed="SearchEntry_Completed" />
            </Grid>

            <CollectionView x:Name="Suggestions"
                            IsVisible="False"
                            SelectionMode="Single"
                            SelectionChanged="Suggestions_SelectionChanged"
                            HeightRequest="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10">
                            <Label Text="{Binding .}" FontSize="15"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Border>
</ContentView>