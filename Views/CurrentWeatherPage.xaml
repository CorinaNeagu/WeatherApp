<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherApp.Controls"
    x:Class="WeatherApp.Views.CurrentWeatherPage"
    Title="Vremea actuală">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">

            <Label Text="Vremea actuală"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="Află cum este vremea în orașul tău."
                   StyleClass="Muted"
                   FontSize="15" />

            <Border StyleClass="Card" Padding="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                    <controls:CitySearchBox
                        x:Name="CityBox"
                        Placeholder="Caută un oraș..."
                        SearchCompleted="OnSearchClicked" />

                                    <Button Grid.Column="1"
                            Text="Caută"
                            Clicked="OnSearchClicked"
                            FontSize="16"
                            Padding="18,12"
                            VerticalOptions="Start" />

                </Grid>
            </Border>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="#DC2626" />

            <Border x:Name="WeatherCard"
                    StyleClass="Card"
                    IsVisible="False"
                    Padding="22"
                    StrokeShape="RoundRectangle 24">

                <VerticalStackLayout Spacing="18">

                    <Label x:Name="CityLabel"
                           FontSize="21"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Label x:Name="TemperatureLabel"
                           FontSize="52"
                           FontAttributes="Bold"
                           TextColor="#512BD4"
                           HorizontalOptions="Center" />

                    <Label x:Name="ConditionLabel"
                           FontSize="17"
                           StyleClass="Muted"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="20">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="🌡️ Resimțită" StyleClass="Muted" />
                            <Label x:Name="FeelsLikeLabel" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="💧 Umiditate" StyleClass="Muted" />
                            <Label x:Name="HumidityLabel" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Spacing="6">
                            <Label Text="💨 Vânt" StyleClass="Muted" />
                            <Label x:Name="WindLabel" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="🕒 Actualizat" StyleClass="Muted" />
                            <Label x:Name="UpdatedLabel" FontSize="15" />
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>