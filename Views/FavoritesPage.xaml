<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WeatherApp.Views.FavoritesPage"
    Title="Orașe favorite"
    BackgroundColor="{AppThemeBinding Light=#F3F6FC, Dark=#17171A}">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="15">

        <VerticalStackLayout Grid.Row="0" Spacing="5">

            <Label
                Text="Orașe favorite"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#172554, Dark=White}" />

            <Label
                Text="Salvează orașele și urmărește schimbările de temperatură."
                FontSize="14"
                TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}" />

        </VerticalStackLayout>

        <Entry
            Grid.Row="1"
            x:Name="CityEntry"
            Placeholder="Introdu un oraș..."
            TextColor="{AppThemeBinding Light=#172554, Dark=White}"
            PlaceholderColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" />

        <Button
            Grid.Row="2"
            Text="Adaugă la favorite"
            Clicked="OnAddClicked"
            BackgroundColor="#2563EB"
            TextColor="White"
            CornerRadius="12" />

        <Label
            Grid.Row="3"
            x:Name="CountLabel"
            Text="0 orașe favorite"
            FontAttributes="Bold"
            TextColor="{AppThemeBinding Light=#172554, Dark=White}" />

        <CollectionView
            Grid.Row="4"
            x:Name="FavoritesCollectionView"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="Nu ai adăugat încă orașe favorite."
                    TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}"
                    HorizontalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3A3A3A}"
                        StrokeShape="RoundRectangle 16"
                        Padding="15"
                        Margin="0,0,0,12">

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="{Binding CityName}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#172554, Dark=White}" />

                            <Label
                                Text="{Binding Country}"
                                TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="5">

                                    <Label
                                        Text="Temperatura anterioară"
                                        TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}" />

                                    <Label
                                        Text="{Binding PreviousTemperatureText}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#172554, Dark=White}" />

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label
                                        Text="Ultima temperatură"
                                        TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}" />

                                    <Label
                                        Text="{Binding LastTemperatureText}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" />

                                </VerticalStackLayout>

                            </Grid>

                            <Label
                                Text="{Binding TrendText}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" />

                            <Label
                                Text="{Binding PreviousCheckedText}"
                                TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}"
                                FontSize="12" />

                            <Label
                                Text="{Binding LastCheckedText}"
                                TextColor="{AppThemeBinding Light=#64748B, Dark=#C8C8C8}"
                                FontSize="12" />

                            <HorizontalStackLayout Spacing="8">

                                <Button
                                    Text="Actualizează"
                                    Clicked="OnUpdateWeatherClicked"
                                    BackgroundColor="#7770C9"
                                    TextColor="White"
                                    FontSize="13"
                                    Padding="12,8" />

                                <Button
                                    Text="Vezi vremea"
                                    Clicked="OnWeatherClicked"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    FontSize="13"
                                    Padding="12,8" />

                                <Button
                                    Text="Șterge"
                                    Clicked="OnDeleteClicked"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    FontSize="13"
                                    Padding="12,8" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
