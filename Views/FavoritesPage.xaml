<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherApp.Controls"
    x:Class="WeatherApp.Views.FavoritesPage"
    Title="Orașe favorite">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          RowSpacing="15">

        <VerticalStackLayout Grid.Row="0" Spacing="5">

            <Label
                Text="Orașe favorite"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Salvează orașele pe care le preferi."
                StyleClass="Muted"
                FontSize="14" />

        </VerticalStackLayout>

        <controls:CitySearchBox
            Grid.Row="1"
            x:Name="CityBox"
            Placeholder="Introdu un oraș..."
            SearchCompleted="OnAddClicked" />
        
        <Button
            Grid.Row="2"
            x:Name="AddButton"
            Text="Adaugă la favorite"
            Clicked="OnAddClicked"
            FontSize="16" />

        <Label
            Grid.Row="3"
            x:Name="CountLabel"
            Text="0 orașe favorite"
            FontAttributes="Bold" />

        <CollectionView
            Grid.Row="4"
            x:Name="FavoritesCollectionView"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="Nu ai adăugat încă orașe favorite."
                    StyleClass="Muted"
                    FontSize="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        StyleClass="Card"
                        Padding="15"
                        Margin="0,0,0,10">

                        <VerticalStackLayout Spacing="12">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="{Binding CityName}"
                                    FontSize="19"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Country}"
                                    StyleClass="Muted" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="10">

                                <Button
                                    Text="Vezi vremea"
                                    CommandParameter="{Binding CityName}"
                                    Clicked="OnWeatherClicked"
                                    CornerRadius="10" />

                                <Button
                                    Text="Șterge"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnDeleteClicked"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    CornerRadius="10" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <ActivityIndicator
            Grid.Row="5"
            x:Name="LoadingIndicator"
            IsRunning="False"
            IsVisible="False"
            HorizontalOptions="Center" />

    </Grid>
</ContentPage>