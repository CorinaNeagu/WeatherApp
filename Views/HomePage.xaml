<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WeatherApp.Pages.HomePage"
    Title="Home">

    <Grid>

        <Image
            Source="background.jpg"
            Aspect="AspectFill"
            Opacity="0.18"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"/>


        <ScrollView>

            <Grid RowDefinitions="Auto, Auto, Auto" 
              Padding="28,20" 
              RowSpacing="14" >

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label
                        Text="WEATHER APP"
                        FontSize="11"
                        CharacterSpacing="3"
                        FontAttributes="Bold"
                        TextColor="#8585A5"/>

                    <Label
                        Text="Bună! ☀️"
                        FontSize="28"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Descoperă lumea prin vreme."
                        FontSize="13"
                        TextColor="#85899B"/>
                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="8"
                    VerticalOptions="Center">

                    <Button
                        Text="❤️"
                        FontSize="20"
                        BorderColor="{AppThemeBinding Light=#ECECF3, Dark=#3A3A3A}"
                        BorderWidth="1"
                        CornerRadius="22"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                        Clicked="FavoriteButton_Clicked"/>

                    <Button
                        Text="🖰 Despre"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#7770C9, Dark={StaticResource PrimaryDark}}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                        BorderColor="{AppThemeBinding Light=#ECECF3, Dark=#3A3A3A}"
                        BorderWidth="1"
                        CornerRadius="22"
                        HeightRequest="44"
                        Padding="12,0"
                        Clicked="AboutButton_Clicked"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Descoperă"
                        FontSize="19"
                        FontAttributes="Bold"/>

                    <Label
                        Grid.Column="1"
                        Text="01 — 07"
                        FontSize="11"
                        TextColor="#9294A5"
                        VerticalOptions="Center"/>
                </Grid>
                
                

                <CarouselView
                    x:Name="WeatherCarousel"
                    HeightRequest="360"
                    ItemsSource="{Binding WeatherImages}"
                    IsSwipeEnabled="True"
                    Loop="True"
                    PeekAreaInsets="140">

                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0" RowDefinitions="Auto,*">
                                <Border
                                    Grid.Row="0"
                                    StyleClass="Card"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10"
                                    HorizontalOptions="End"
                                    Margin="0,0,8,2"
                                    WidthRequest="165">

                                    <VerticalStackLayout Spacing="3">
                                        <Label
                                            Text="{Binding Title, StringFormat='💭 {0}'}"
                                            FontSize="13"
                                            FontAttributes="Bold"/>
                                        <Label
                                            Text="{Binding Description}"
                                            StyleClass="Muted"
                                            FontSize="10"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    WidthRequest="270"
                                    HeightRequest="270"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start"
                                    StrokeThickness="4"
                                    Stroke="{AppThemeBinding Light=#FFFFFF, Dark=#252525}"
                                    StrokeShape="Ellipse"
                                    BackgroundColor="{AppThemeBinding Light=#D9DCEC, Dark=#303B45}">

                                    <Image
                                        Source="{Binding Image}"
                                        Aspect="AspectFill"
                                        WidthRequest="270"
                                        HeightRequest="270">
                                        <Image.Clip>
                                            <EllipseGeometry
                                                Center="135,135"
                                                RadiusX="135"
                                                RadiusY="135"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="CurrentItem">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="PreviousItem">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.75"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="NextItem">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.75"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <IndicatorView
                    x:Name="CarouselIndicators"
                    HorizontalOptions="Center"
                    IndicatorColor="{AppThemeBinding Light=#D5D6E1, Dark=#4A4A55}"
                    SelectedIndicatorColor="#7770C9"
                    IndicatorSize="7"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Label
                    Text="Explorează aplicația"
                    FontSize="19"
                    FontAttributes="Bold"/>

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="11"
                    RowSpacing="11">

                    <Border Grid.Row="0" Grid.Column="0" StyleClass="Card" StrokeShape="RoundRectangle 16" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CurrentWeatherCard_Tapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="☀️" FontSize="22"/>
                            <Label Text="Vremea actuală" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="Condiții meteo" FontSize="11" TextColor="#9294A5"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" StyleClass="Card" StrokeShape="RoundRectangle 16" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="StatisticsCard_Tapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📊" FontSize="22"/>
                            <Label Text="Statistici meteo" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="Grafice și analize" FontSize="11" TextColor="#9294A5"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" StyleClass="Card" StrokeShape="RoundRectangle 16" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ForecastCard_Tapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🌤️" FontSize="22"/>
                            <Label Text="Prognoza meteo" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="Prognoza pe zile" FontSize="11" TextColor="#9294A5"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" StyleClass="Card" StrokeShape="RoundRectangle 16" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AirQualityCard_Tapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🌿" FontSize="22"/>
                            <Label Text="Condiții de mediu" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="Informații de mediu" FontSize="11" TextColor="#9294A5"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>

        </Grid>
        </ScrollView>
        <Grid
            x:Name="FavoriteToast"
            IsVisible="False"
            Opacity="0"
            BackgroundColor="#80000000"
            Padding="24"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="10">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CloseFavoriteToast_Clicked"/>
            </Grid.GestureRecognizers>

            <Border
                StyleClass="Card"
                StrokeShape="RoundRectangle 20"
                Padding="30"
                WidthRequest="280"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="❤️" FontSize="42" HorizontalTextAlignment="Center"/>
                    <Label Text="Favorite" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Orașele tale preferate" StyleClass="Muted" FontSize="14" HorizontalTextAlignment="Center"/>

                    <CollectionView
                        x:Name="FavoriteCollectionView"
                        HeightRequest="180"
                        SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Nu ai adăugat încă orașe favorite." StyleClass="Muted" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=#F3F6FC, Dark=#2F2F2F}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,3">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding CityName}" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Country}" StyleClass="Muted" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="CarouselLoadingOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light=#80F7F8FC, Dark=#8017171A}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              ZIndex="5">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" Color="#7770C9" WidthRequest="40" HeightRequest="40"/>
                <Label Text="Se încarca..." FontSize="13" TextColor="#7770C9" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
       
</ContentPage>