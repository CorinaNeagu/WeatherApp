<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WeatherApp.Pages.HomePage"
    Title="Home"
    BackgroundColor="#F7F8FC">

    <Grid>

        <Image
        Source="background.jpg"
        Aspect="AspectFill"
        Opacity="0.18"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        InputTransparent="True"/>

        <ScrollView>
            <VerticalStackLayout
                Padding="28,30"
                Spacing="22">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="WEATHER APP"
                            FontSize="11"
                            CharacterSpacing="3"
                            FontAttributes="Bold"
                            TextColor="#8585A5"/>

                        <Label
                            Text="Buna! ☀️"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="#242638"/>

                        <Label
                            Text="Descopera lumea prin vreme."
                            FontSize="14"
                            TextColor="#85899B"/>
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="❤️"
                        FontSize="25"
                        BackgroundColor="White"
                        BorderColor="#ECECF3"
                        BorderWidth="1"
                        CornerRadius="25"
                        WidthRequest="54"
                        HeightRequest="54"
                        Clicked="FavoriteButton_Clicked"
                        HorizontalOptions="End"
                        Margin="0,0,20,0"
                        VerticalOptions="Center"/>
                </Grid>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Descopera"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#242638"/>

                        <Label
                            Grid.Column="1"
                            Text="01 — 07"
                            FontSize="11"
                            TextColor="#9294A5"
                            VerticalOptions="Center"/>
                    </Grid>

                    <CarouselView
                        x:Name="WeatherCarousel"
                        HeightRequest="440"
                        ItemsSource="{Binding WeatherImages}"
                        IsSwipeEnabled="True"
                        Loop="True"
                        PeekAreaInsets="180">

                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                            Padding="0"
                            RowDefinitions="Auto,*">    

                               <Border
                    Grid.Row="0"
                    BackgroundColor="#F2FFFFFF"
                    Stroke="#FFFFFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="12"
                    HorizontalOptions="End"
                    Margin="0,0,8,2"
                    WidthRequest="175">

                                        <VerticalStackLayout Spacing="5">
                                            <Label
                                                Text="{Binding Title, StringFormat='💭 {0}'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="#292B3D"/>
                                            <Label
                            Text="{Binding Description}"
                            FontSize="11"
                            TextColor="#626579"/>
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border
                    Grid.Row="1"
                    WidthRequest="335"
                    HeightRequest="335"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    StrokeThickness="5"
                    Stroke="#FFFFFF"
                    StrokeShape="Ellipse"
                    BackgroundColor="#D9DCEC">

                                        <Image
                        Source="{Binding Image}"
                        Aspect="AspectFill"
                        WidthRequest="335"
                        HeightRequest="335">

                                            <Image.Clip>
                                                <EllipseGeometry
                                Center="167.5,167.5"
                                RadiusX="167.5"
                                RadiusY="167.5"/>
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">

                                            <VisualState Name="CurrentItem">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1"/>
                                                </VisualState.Setters>
                                            </VisualState>

                                            <VisualState Name="PreviousItem">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.72"/>
                                                </VisualState.Setters>
                                            </VisualState>

                                            <VisualState Name="NextItem">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.72"/>
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView
                        x:Name="CarouselIndicators"
                        HorizontalOptions="Center"
                        IndicatorColor="#D5D6E1"
                        SelectedIndicatorColor="#7770C9"
                        IndicatorSize="8"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="13">

                    <Label
                        Text="Exploreaza aplicatia"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#242638"/>

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="13"
                        RowSpacing="13">

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#ECECF3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="17">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CurrentWeatherCard_Tapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="☀️" FontSize="27"/>
                                <Label
                                    Text="Vremea actuala"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#292B3D"/>
                                            <Label
                                    Text="Condiții meteo"
                                    FontSize="12"
                                    TextColor="#9294A5"/>   
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#ECECF3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="17">       

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="StatisticsCard_Tapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="📊" FontSize="27"/>
                                <Label
                                    Text="Statistici meteo"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#292B3D"/>
                                                <Label
                                    Text="Grafice și analize"
                                    FontSize="12"
                                    TextColor="#9294A5"/>   
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#ECECF3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="17">   

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ForecastCard_Tapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="🌤️" FontSize="27"/>
                                <Label
                                    Text="Prognoza meteo"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#292B3D"/>
                                                    <Label
                                    Text="Prognoză pe zile"
                                    FontSize="12"
                                    TextColor="#9294A5"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#ECECF3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="17">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AirQualityCard_Tapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="🌿" FontSize="27"/>
                                <Label
                                    Text="Condiții de mediu"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#292B3D"/>
                                <Label
                                    Text="Informații de mediu"
                                    FontSize="12"
                                    TextColor="#9294A5"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid
            x:Name="FavoriteToast"
            IsVisible="False"
            Opacity="0"
            BackgroundColor="#80000000"
            Padding="24"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="10">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer
            Tapped="CloseFavoriteToast_Clicked"/>
            </Grid.GestureRecognizers>


            <Border
                BackgroundColor="White"
                Stroke="#ECECF3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="30"
                WidthRequest="280"
                HorizontalOptions="Center"
                VerticalOptions="Center">   

                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">

                    <Label
                    Text="❤️"
                    FontSize="42"
                    HorizontalTextAlignment="Center"/>

                     <Label
                    Text="Favorite"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#263445"
                    HorizontalTextAlignment="Center"/>

                    <Label
                    Text="Bine ai venit la favorite!"
                    FontSize="14"
                    TextColor="Gray"
                    HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
