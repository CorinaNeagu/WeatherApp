<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.Views.StatisticsPage"
             Title="Statistici meteo">

    <ScrollView>
        
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="Statistici meteo"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Label Text="Alege orasul"
       FontSize="16"
       FontAttributes="Bold" />

            <Button
    Text="Mai multe statistici →"
    FontSize="12"
    FontAttributes="Bold"
    TextColor="White"
    CornerRadius="10"
    HeightRequest="38"
    Padding="12,4"
    HorizontalOptions="End"
    WidthRequest="190"
    Clicked="OpenAdvancedStatistics_Clicked" />


            <Border Stroke="#78909C"
        StrokeThickness="1"
        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
        Padding="0"
        StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="Auto,*"
              Padding="14,4"
              ColumnSpacing="10">

                        <Label Text="⌕"
                   FontSize="24"
                   VerticalOptions="Center"
                   TextColor="#2196F3" />

                        <Entry x:Name="CitySearchEntry"
                   Grid.Column="1"
                   Placeholder="Caută un oraș..."
                   BackgroundColor="Transparent"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="CitySearchEntry_TextChanged"
                   Margin="0" />
                    </Grid>

                    <BoxView HeightRequest="1"
                 BackgroundColor="#78909C"
                 Opacity="0.4" />

                    <CollectionView x:Name="CitySuggestions"
                        IsVisible="False"
                        SelectionMode="Single"
                        SelectionChanged="CitySuggestions_SelectionChanged"
                        HeightRequest="180">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,10">
                                    <Label Text="{Binding .}"
                               FontSize="15"
                               VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <Label x:Name="SelectedCityLabel"
       Text="Niciun oraș selectat"
       FontSize="13"
       TextColor="Gray"
       Margin="4,0,0,0" />


            <Label Text="Perioada statisticilor"
                   FontAttributes="Bold" />

            <Picker x:Name="PeriodPicker"
                    Title="Selectează perioada"
                    SelectedIndexChanged="PeriodPicker_SelectedIndexChanged">
                <Picker.Items>
                    <x:String>Ultimele 7 zile</x:String>
                    <x:String>Ultimele 30 de zile</x:String>
                    <x:String>Ultimele 3 luni</x:String>
                    <x:String>Ultimele 6 luni</x:String>
                    <x:String>Ultimele 9 luni</x:String>
                    <x:String>Ultimul an</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Încarcă statisticile"
                    Clicked="LoadStatistics_Clicked" />

            <VerticalStackLayout x:Name="DashboardSection"
                     Spacing="16"
                     IsVisible="False">

                <Label Text="Analiza vremii"
           FontSize="24"
           FontAttributes="Bold" />

                <Label Text="Exploreaza evolutia conditiilor meteo"
           FontSize="13"
           TextColor="Gray" />

               
                <Border x:Name="TemperatureCard"
            Padding="16"
            BackgroundColor="#F1F3F5"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌡️ Temperatura"
                   FontSize="18"
                   FontAttributes="Bold" />

                        <Label Text="Evolutia temperaturii medii zilnice"
                   FontSize="13"
                   TextColor="Gray" />

                        <GraphicsView x:Name="TemperatureChart"
                          HeightRequest="240" />
                    </VerticalStackLayout>
                </Border>

                
                <Border x:Name="HumidityCard"
            Padding="16"
            BackgroundColor="#F1F3F5"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="💧 Umiditate"
                   FontSize="18"
                   FontAttributes="Bold" />

                        <Label Text="Variatia umiditatii medii zilnice"
                   FontSize="13"
                   TextColor="Gray" />

                        <GraphicsView x:Name="HumidityChart"
                          HeightRequest="220" />
                    </VerticalStackLayout>
                </Border>

                
                <Grid ColumnDefinitions="*,*"
          ColumnSpacing="12">

                    <Border x:Name="GaugeCard"
                Grid.Column="0"
                Padding="12"
                BackgroundColor="#F1F3F5"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="🎯 Temperatura medie"
                       FontSize="15"
                       FontAttributes="Bold" />

                            <GraphicsView x:Name="TemperatureGauge"
                              HeightRequest="170" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="WeatherDistributionCard"
        Grid.Column="1"
        Padding="12"
        BackgroundColor="#F1F3F5"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="🍩 Distribuția vremii"
               FontSize="15"
               FontAttributes="Bold" />

                            <Label Text="Condiții meteo în perioada selectată"
               FontSize="11"
               TextColor="Gray" />

                            <GraphicsView x:Name="WeatherDistributionChart"
                      HeightRequest="190" />
                            <Grid ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="8"
      RowSpacing="8">

                                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                    <BoxView Color="#FBC02D" WidthRequest="10" HeightRequest="10"
                                       CornerRadius="5" VerticalOptions="Center" />
                                    <Label x:Name="SunnyCountLabel"
                                       Text="Senin (0)"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                  <BoxView Color="#78909C" WidthRequest="10" HeightRequest="10"
                                         CornerRadius="5" VerticalOptions="Center" />
                                    <Label x:Name="CloudyCountLabel"
                                       Text="Înnorat (0)"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                                    <BoxView Color="#2196F3" WidthRequest="10" HeightRequest="10"
                                             CornerRadius="5" VerticalOptions="Center" />
                                    <Label x:Name="RainyCountLabel"
                                       Text="Ploaie (0)"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                    <BoxView Color="#80DEEA" WidthRequest="10" HeightRequest="10"
                                            CornerRadius="5" VerticalOptions="Center" />
                                    <Label x:Name="SnowyCountLabel"
                                       Text="Ninsoare (0)"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                
                <Border Padding="12"
            BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#252525}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Legendă temperatură"
                   FontSize="13"
                   FontAttributes="Bold" />

                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto"
                  ColumnSpacing="4">

                            <BoxView Grid.Column="0" Color="#1565C0" HeightRequest="12" />
                            <Label Grid.Column="1" Text="&lt;0°" FontSize="10" VerticalOptions="Center" />

                            <BoxView Grid.Column="2" Color="#42A5F5" HeightRequest="12" />
                            <Label Grid.Column="3" Text="0–10°" FontSize="10" VerticalOptions="Center" />

                            <BoxView Grid.Column="4" Color="#FDD835" HeightRequest="12" />
                            <Label Grid.Column="5" Text="10–20°" FontSize="10" VerticalOptions="Center" />

                            <BoxView Grid.Column="6" Color="#FB8C00" HeightRequest="12" />
                            <Label Grid.Column="7" Text="20–30°" FontSize="10" VerticalOptions="Center" />

                            <BoxView Grid.Column="8" Color="#E53935" HeightRequest="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                
                <Border x:Name="BoxPlotCard"
            Padding="16"
            BackgroundColor="#F1F3F5"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="📊 Distribuția temperaturilor"
                   FontSize="18"
                   FontAttributes="Bold" />

                        <Label Text="Minim, quartile, mediană și maxim"
                   FontSize="13"
                   TextColor="Gray" />

                        <GraphicsView x:Name="TemperatureBoxPlot"
                          HeightRequest="200" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>





            
            <VerticalStackLayout Spacing="12"
                     HorizontalOptions="Center"
                     WidthRequest="520"
                     MaximumWidthRequest="520">

                <Label Text="Istoric masuratori"
           FontSize="21"
           FontAttributes="Bold"
           HorizontalOptions="Start" />

                <Border Padding="0"
            Stroke="#D5DDE5"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
            StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="0">

                        <Grid Padding="10,11"
                  ColumnDefinitions="1.2*,0.8*,0.8*,0.8*"
                  BackgroundColor="{AppThemeBinding Light=#E8EEF4, Dark=#303B45}">

                            <Label Text="DATA"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#455A64, Dark=White}" />

                            <Label Grid.Column="1"
                       Text="TEMP."
                       FontSize="10"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#455A64, Dark=White}" />

                            <Label Grid.Column="2"
                       Text="UMID."
                       FontSize="10"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#455A64, Dark=White}" />

                            <Label Grid.Column="3"
                       Text="VÂNT"
                       FontSize="10"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="End"
                       TextColor="{AppThemeBinding Light=#455A64, Dark=White}" />
                        </Grid>

                        <CollectionView x:Name="StatisticsCollection"
                            SelectionMode="None"
                            MaximumHeightRequest="350">

                            <CollectionView.EmptyView>
                                <Label Text="Nu există măsurători disponibile."
                           Padding="16"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,9"
                              ColumnDefinitions="1.2*,0.8*,0.8*,0.8*">

                                        <Label Text="{Binding RecordedAt, StringFormat='{0:dd.MM.yy}'}"
                                   FontSize="11"
                                   VerticalOptions="Center" />

                                        <Label Grid.Column="1"
                                   Text="{Binding Temperature, StringFormat='{0:F1}°'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   TextColor="#E87532" />

                                        <Label Grid.Column="2"
                                   Text="{Binding Humidity, StringFormat='{0}%'}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   TextColor="#2995D6" />

                                        <Label Grid.Column="3"
                                   Text="{Binding WindSpeed, StringFormat='{0:F1}'}"
                                   FontSize="11"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center" />

                                        <BoxView Grid.Row="1"
                                     Grid.ColumnSpan="4"
                                     HeightRequest="1"
                                     Color="#E5E9ED"
                                     VerticalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
